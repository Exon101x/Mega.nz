# --- required -------------------------------------------------------------
API_ID=
API_HASH=
BOT_TOKEN=
# Your numeric Telegram user id (send /id to @userinfobot or to this bot after first start). Several: 111,222
OWNER_IDS=

# --- optional ------------------------------------------------------------
# Telegram *user* session string (python gen_session.py): enables "upload via user account"
# (4 GB on Premium, or posting where a bot can't). Leave empty to use the bot only.
USER_SESSION=
# 1 = anyone may use the bot (not recommended); 0 = only owners + users added with /allow
PUBLIC=0
DATA_DIR=./data
MAX_CONCURRENT=1          # jobs processed at the same time (1 is best on small machines)
MAX_FILES_ON_DISK=1       # hard cap on files being downloaded/uploaded at once, across ALL jobs (keep 1 to protect the disk)
EDIT_INTERVAL=3           # seconds between live-card edits (animations); raise on slow hosts
MIN_FREE_GB=1             # keep at least this much disk free
QUOTA_COOLDOWN_MIN=45     # how long a route rests after Mega's bandwidth-limit error
ERROR_COOLDOWN_MIN=5      # how long a proxy rests after a network error
MAX_ATTEMPTS=6            # route attempts per file
UPLOAD_DELAY=1.5          # pause between files (avoids Telegram flood limits)
STALL_TIMEOUT=150         # abort a download that makes no progress for this many seconds
DEFAULT_DAILY_GB=0        # per-user daily limit for non-admins (0 = unlimited)
ADMIN_LOG_CHAT=0
LOG_LEVEL=INFO
# OPTIONAL (only for Mega accounts): full path to a megatools binary installed outside the PATH, e.g.
# MEGATOOLS_BIN=/home/youruser/.local/bin/megatools
MEGATOOLS_BIN=
# SECRET_KEY=             # Fernet key for stored Mega passwords; auto-generated into data/secret.key if empty
